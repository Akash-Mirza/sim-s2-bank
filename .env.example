# Copy to .env for local development. Values are placeholders, never real secrets.
NODE_ENV=development
HOST=0.0.0.0
API_PORT=4002
DATABASE_URL=postgres://sim_s2:sim_s2@localhost:5435/sim_s2
LOG_LEVEL=info
API_KEY_PEPPER=replace-with-32-byte-random-hex
# Local development opt-in. Production must keep this false; the app fails
# closed when NODE_ENV=production and this is true.
ENABLE_DEV_OPS=true
OPS_DEV_TOKEN=dev-ops-token
# Ops console sessions (S2-10). Create an operator with `pnpm ops:user create`.
# OPS_SESSION_TTL_HOURS=12
# Encrypts stored webhook signing secrets. If unset, a distinct key is derived
# from API_KEY_PEPPER; setting it is recommended outside local demos.
WEBHOOK_SECRET_KEY=replace-with-a-separate-32-byte-random-hex
# SIM_CLOCK=2026-11-06T09:00:00.000Z
# SERVICE_VERSION=0.4.0-dev.0
# GIT_COMMIT=dev
