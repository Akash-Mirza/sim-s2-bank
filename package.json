{
  "name": "sim-s2-bank",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "S2 bank simulator - corporate AED ledger, statements, and local payout rail (simulated)",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run test/unit test/contract",
    "test:contract": "vitest run test/contract",
    "test:integration": "vitest run test/integration",
    "openapi": "tsx src/cli/openapi.ts",
    "openapi:check": "tsx src/cli/openapi.ts --check",
    "migrate": "tsx src/cli/migrate.ts",
    "seed": "tsx src/cli/seed.ts",
    "reset": "tsx src/cli/reset.ts",
    "ops:user": "tsx src/cli/ops-user.ts",
    "key:issue": "tsx src/cli/api-key.ts"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
